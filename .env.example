# EthinX Short-Form — Copy to .env and fill real keys. NEVER commit .env with real secrets.
# See README Security Warning.

DATABASE_URL="postgresql://postgres:password@localhost:5433/ethinx_shortform?schema=public"
REDIS_URL="redis://localhost:6379"

# Get from https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Get from https://elevenlabs.io/app/settings/api-keys (starts with sk_)
# Voice ID 21m00Tcm4TlvDq8ikWAM (Rachel) is default
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_KEY=your_elevenlabs_api_key_here

# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_KEY=your_google_cloud_key_here
VERTEX_KEY=your_vertex_key_here

# PayPal — keep SINGLE and FOURPACK, no duplicate PAYPAL_LINK
PAYPAL_LINK_SINGLE=https://www.paypal.com/ncp/payment/EXAMPLE_SINGLE
PAYPAL_LINK_FOURPACK=https://www.paypal.com/ncp/payment/EXAMPLE_FOURPACK

# Bank Transfer
BANK_NAME=Macquarie Bank
BANK_BSB=182182
BANK_ACCOUNT=033667619

# Feature flags — Dodo disabled until KYC
DODO_ENABLED=false
NEXT_PUBLIC_DODO_ENABLED=false

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_PAYPAL_LINK_SINGLE=https://www.paypal.com/ncp/payment/EXAMPLE_SINGLE
NEXT_PUBLIC_PAYPAL_LINK_FOURPACK=https://www.paypal.com/ncp/payment/EXAMPLE_FOURPACK
NEXT_PUBLIC_BANK_NAME=Macquarie Bank
NEXT_PUBLIC_BANK_BSB=182182
NEXT_PUBLIC_BANK_ACCOUNT=033667619
